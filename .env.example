# Copiar como .Renviron o configurar estos valores como secretos en Posit Connect.
# Nunca guardar la contraseña real en Git.
SUPABASE_PROJECT_REF=psteqbwnyavrmwdiiaht
SUPABASE_HOST=<host-directo-o-pooler-mostrado-en-supabase-connect>
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=<usuario-mostrado-en-supabase-connect>
SUPABASE_PASSWORD=<contrasena-de-base-de-datos>

# Solo se necesita durante la carga administrativa inicial.
SUPABASE_IMPORT_CONFIRM=REEMPLAZAR_CAPAS_PDU

# Opcionales para las métricas mediante REST/RPC. La clave publicable reemplaza
# a la antigua clave anon. No configure SUPABASE_SECRET_KEY en la aplicación.
SUPABASE_URL=https://psteqbwnyavrmwdiiaht.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
