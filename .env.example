# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - GEOVISOR PDU ANTA (2024 - 2034)
# Copiar como .Renviron para desarrollo local. Nunca subir contraseñas a Git.
# ==============================================================================

# Fuente de datos espacial activa
# Opciones: 
#   'neon'  (Neon Serverless PostgreSQL + PostGIS en Cloud - Oficial)
#   'local' (Shapefiles en data/ o archivo optimizado en data_pdu/)
PDU_DATA_SOURCE=neon

# ------------------------------------------------------------------------------
# CREDENCIALES DE NEON SERVERLESS POSTGRESQL (AWS OREGON)
# Configurar estos valores en su archivo .Renviron local o en Posit Connect Cloud.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://<usuario>:<contrasena>@<host-neon>.aws.neon.tech/neondb?sslmode=require
NEON_HOST=<host-neon>.aws.neon.tech
NEON_PORT=5432
NEON_DB=neondb
NEON_USER=<usuario>
NEON_PASSWORD=<contrasena>
NEON_SSLMODE=require

# ------------------------------------------------------------------------------
# [DEPRECADO] CREDENCIALES HISTÓRICAS DE SUPABASE
# Estas variables se conservan únicamente por compatibilidad con código legado.
# ------------------------------------------------------------------------------
# SUPABASE_PROJECT_REF=psteqbwnyavrmwdiiaht
# SUPABASE_HOST=<host-directo-o-pooler-mostrado-en-supabase-connect>
# SUPABASE_PORT=5432
# SUPABASE_DB=postgres
# SUPABASE_USER=<usuario-mostrado-en-supabase-connect>
# SUPABASE_PASSWORD=<contrasena-de-base-de-datos>
# SUPABASE_IMPORT_CONFIRM=REEMPLAZAR_CAPAS_PDU
# SUPABASE_URL=https://psteqbwnyavrmwdiiaht.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable-key>
