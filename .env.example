# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - GEOVISOR PDU ANTA (2024 - 2034)
# Copiar como .Renviron para desarrollo local. Nunca subir contraseñas a Git.
# ==============================================================================

# Fuente de datos espacial activa (Por defecto: local)
# Opciones actuales: 'local' (Shapefiles en data/)
# Próxima opción:    'neon'  (Neon Serverless PostgreSQL + PostGIS)
PDU_DATA_SOURCE=local

# ------------------------------------------------------------------------------
# [FUTURA MIGRACIÓN] CREDENCIALES PREVISTAS PARA NEON SERVERLESS POSTGRESQL
# Una vez culminados los ajustes en la app, se activará Neon:
# ------------------------------------------------------------------------------
# NEON_HOST=ep-tu-proyecto-pooler.us-east-2.aws.neon.tech
# NEON_PORT=5432
# NEON_DB=neondb
# NEON_USER=<usuario_neon>
# NEON_PASSWORD=<contrasena_neon>
# NEON_SSLMODE=require
# O mediante DATABASE_URL completa:
# DATABASE_URL=postgresql://<usuario>:<password>@ep-tu-proyecto-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# [DEPRECADO] CREDENCIALES HISTÓRICAS DE SUPABASE
# Estas variables se conservan únicamente por compatibilidad con código legado.
# ------------------------------------------------------------------------------
# SUPABASE_PROJECT_REF=psteqbwnyavrmwdiiaht
# SUPABASE_HOST=<host-directo-o-pooler-mostrado-en-supabase-connect>
# SUPABASE_PORT=5432
# SUPABASE_DB=postgres
# SUPABASE_USER=<usuario-mostrado-en-supabase-connect>
# SUPABASE_PASSWORD=<contrasena-de-base-de-datos>
# SUPABASE_IMPORT_CONFIRM=REEMPLAZAR_CAPAS_PDU
# SUPABASE_URL=https://psteqbwnyavrmwdiiaht.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable-key>
